<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginTop="4dp"
    android:background="@drawable/widget_completed"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="8dp">
    <TextView android:layout_width="40dp" android:layout_height="match_parent" android:gravity="center" android:text="@string/widget_checked" android:textColor="@color/widget_text_secondary" android:textSize="22sp" />
    <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="整理房間" android:textColor="@color/priority_low_text" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="2dp" android:layout_gravity="center_vertical" android:background="@color/widget_strike" />
    </FrameLayout>
</LinearLayout>
